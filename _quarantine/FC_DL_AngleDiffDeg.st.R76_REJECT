(*==============================================================================
 * 名称 : FC_DL_AngleDiffDeg —— 两角度差归一到 [-180,180)（度）
 * 分类 / 前缀 / 版本 : DL_MathData / FC_DL_ / 1.0.0
 * 溯源 : 开源语义参考（OSCAT/AixOCAT 族，MIT）或 clean-room IEC 实现，未复制源码
 * 平台 : 纯 IEC 61131-3
 * 功能说明 : 计算 fA - fB 的最短弧差并归一到 [-180,180)（左闭右开，-180 属于
 *            区间、+180 不属于）。先整体 TRUNC 缩圈再小步修正，无循环收敛。
 *            边界处理：任一输入 NaN（f<>f）或 ±Inf（(f-f)<>(f-f)）时置 eErr
 *            返回 0.0；|差值|>1.0E12 时超出安全归一量程（防 TRUNC 精度塌陷）
 *            同样置 eErr 返回 0.0。
 * 错误码 : 16#0001_1B01 = 输入非有限（NaN/±Inf）或差值超安全归一量程 ±1.0E12
 *          eErr=0 且 bValid=TRUE 表示返回值可用
 * 状态机 : R6 标注 N/A（纯函数无顺序状态，以本节替代 ELSE 兜底）
 * 红线 : R1/R2/R3 ✓ 零全局/零IO/纯IEC ｜ R4 ✓ 非有限拦截/量程防护 ｜ R10 ✓ 标准转换 ｜ R11 ✓ 分号收尾 ｜ R15 ✓ 无保留字撞名
 * 修订记录 : 2026-11-23 v1.0.0 首次入库（R76）
 *============================================================================*)
FUNCTION FC_DL_AngleDiffDeg : LREAL
VAR_INPUT
    fA : LREAL;    // 角度 A [度] / angle A in degrees
    fB : LREAL;    // 角度 B [度] / angle B in degrees
END_VAR
VAR_OUTPUT
    eErr   : UDINT;    // 故障码，0=正常，1B01=输入非有限或超量程 / error code
    bError : BOOL;     // TRUE=本件发生故障 / TRUE when fault occurred
    bValid : BOOL;     // TRUE=返回值可用 / TRUE when return value is usable
END_VAR
VAR
    _d : LREAL;        // 原始差值 [度] / raw difference
    _n : LREAL;        // 整圈数（TRUNC 截断）[圈] / whole turns via truncation
END_VAR

FC_DL_AngleDiffDeg := 0.0;                   // 返回值预设 0.0 / preset return to zero
eErr   := 16#0000_0000;                      // 故障码清零 / clear error code
bError := FALSE;                             // 故障标志清零 / clear error flag
bValid := TRUE;                              // 预设输出可用 / preset valid flag

IF (fA <> fA) OR ((fA - fA) <> (fA - fA))    // fA 为 NaN 或 ±Inf / fA is NaN or infinite
   OR (fB <> fB) OR ((fB - fB) <> (fB - fB)) THEN    // fB 为 NaN 或 ±Inf / fB is NaN or infinite
    eErr   := 16#0001_1B01;                  // 置非有限故障码 / set non-finite code
    bError := TRUE;                          // 置故障标志 / set error flag
    bValid := FALSE;                         // 返回值不可用 / return not usable
    RETURN;                                  // 返回 0.0 / return zero
END_IF

_d := fA - fB;                               // 原始差值 / raw difference
IF ABS(_d) > 1.0E12 THEN                     // 超安全归一量程（防 TRUNC 精度塌陷）/ beyond safe wrap range
    eErr   := 16#0001_1B01;                  // 置超量程故障码 / set out-of-range code
    bError := TRUE;                          // 置故障标志 / set error flag
    bValid := FALSE;                         // 返回值不可用 / return not usable
    RETURN;                                  // 返回 0.0 / return zero
END_IF

_n := TRUNC(_d / 360.0);                     // 整圈截断缩圈（TRUNC 向零取整）/ strip whole turns
_d := _d - 360.0 * _n;                       // 缩到 (-360,360) / reduce to (-360,360)
IF _d >= 180.0 THEN                          // 上越界修正 / fix upper overflow
    _d := _d - 360.0;                        // 减一整圈 / subtract one turn
END_IF
IF _d < -180.0 THEN                          // 下越界修正 / fix lower overflow
    _d := _d + 360.0;                        // 加一整圈 / add one turn
END_IF

FC_DL_AngleDiffDeg := _d;                    // 回写 [-180,180) 差值 / write back wrapped diff

END_FUNCTION
